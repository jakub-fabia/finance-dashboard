# Static dashboard: the page from /srv, and from the data volume only
# dashboard.json (no other data file is reachable).
:80 {
	encode gzip
	header -Server

	handle /dashboard.json {
		root * /data
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /srv
		header /vendor/* Cache-Control "public, max-age=604800"
		header /fonts/* Cache-Control "public, max-age=604800"
		header Cache-Control "no-cache"
		file_server
	}
}
