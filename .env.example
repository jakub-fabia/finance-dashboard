# Copy to .env and fill in. .env is gitignored — it holds your bank session ids.

TZ=Europe/Warsaw

# Host directory with every data file, mounted at /data in both containers.
FINANCE_DATA_DIR=./data

# --- Banks (Enable Banking), see docs/SETUP.md "Bank transactions" ----------
# Short names of your choice, comma-separated. Each is the prefix of that
# bank's four settings below and (lowercased) the `bank` column.
BANKS=MAIN
# The bank's name as Enable Banking lists it (part of it is enough; leave
# empty and authorize.py prints the list).
MAIN_ASPSP=
# One Enable Banking application per bank; its private key goes in
# banks/<APP_ID>.pem. SESSION_ID / ACCOUNT_UID come from banks/authorize.py.
MAIN_APP_ID=
MAIN_SESSION_ID=
MAIN_ACCOUNT_UID=
# A second bank: add it to BANKS (BANKS=MAIN,SECOND) and repeat the four
# lines with the SECOND_ prefix.

# Days fetched per run. Keep ≥ 15: banks backdate rows, overlapping runs are
# de-duplicated by transaction id.
BANKS_LOOKBACK_DAYS=35
# PSD2 allows ~4 automatic fetches per account per day; once a day is plenty.
BANKS_CRON_SCHEDULE=0 6 * * *

# --- Optional overrides (defaults are in the Dockerfile) --------------------
# XTB_REBUILD_CRON_SCHEDULE=2,17,32,47 9-17 * * 1-5;10 18,23 * * 1-5
# XTB_PENDING_ACCOUNT=      # account that bank transfers land in until the next export (default: the PLN_… export)
# CPI_START_YEAR=2022       # oldest CPI year fetched (cover your oldest inflation-linked bond)
